import os

# INPUT folder (your caption files)
input_folder = r"C:\Users\abhis\OneDrive\Desktop\project s8\project_s8\project_s8\loraDataset2.0\adventure_time\40_advtime_style"

# OUTPUT file
output_file = r"C:\Users\abhis\OneDrive\Desktop\project s8\project_s8\project_s8\datasetlora\Aall labels in one\labels_writing\advtime.txt"

# Open output file
with open(output_file, "w", encoding="utf-8") as out:

    # Loop through all txt files
    for file in sorted(os.listdir(input_folder)):
        if file.endswith(".txt"):
            
            file_path = os.path.join(input_folder, file)

            # Read caption from each txt
            with open(file_path, "r", encoding="utf-8") as f:
                caption = f.read().strip()

            # Write: filename + caption
            out.write(f"{file}    {caption}\n")

print("✅ Done! All labels written correctly.")