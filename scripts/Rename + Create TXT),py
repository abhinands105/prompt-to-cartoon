import os

folder = r"C:\Users\abhis\OneDrive\Desktop\project s8\project_s8\project_s8\datasetlora\line art"

caption = "line art portrait sketch drawing, pencil sketch style, clean outline drawing, human face sketch"

count = 1

for file in os.listdir(folder):
    if file.lower().endswith(".jpg"):
        new_name = f"line_art_portrait_sketch_{count:03}.jpg"
        
        old_path = os.path.join(folder, file)
        new_path = os.path.join(folder, new_name)
        
        os.rename(old_path, new_path)
        
        txt_name = new_name.replace(".jpg",".txt")
        txt_path = os.path.join(folder, txt_name)
        
        with open(txt_path,"w") as f:
            f.write(caption)
        
        count += 1